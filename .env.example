# ==========================================================
# .env.example - copie para ".env" e ajuste os valores.
# NUNCA versione o arquivo ".env" real (já está no .gitignore).
# ==========================================================

# ---- Aplicação ----
APP_PORT=8080
SPRING_PROFILES_ACTIVE=staging
# Opcional: imagem já publicada (ex.: ghcr.io/dlcruzz/cidades-esg-inteligentes:latest).
# Se vazio, usa a imagem construída localmente.
APP_IMAGE=

# ---- Banco de dados (PostgreSQL) ----
POSTGRES_DB=cidades_esg
POSTGRES_USER=esg_user
POSTGRES_PASSWORD=troque_esta_senha
DB_EXPOSED_PORT=5432
